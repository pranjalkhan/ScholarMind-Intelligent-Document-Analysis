# Database (PostgreSQL in production/Docker; leave sqlite for zero-config local dev)
DATABASE_URL=sqlite:///./knowflow.db
# DATABASE_URL=postgresql+psycopg://knowflow:knowflow@localhost:5432/knowflow

# JWT Auth
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vector Database (Qdrant)
# Use :memory: or local path for zero-config dev, http://localhost:6333 for Docker, or Qdrant Cloud URL
QDRANT_URL=./qdrant_local
QDRANT_API_KEY=
QDRANT_COLLECTION=knowflow_chunks

# LLM API (OpenAI-compatible: Groq free tier, OpenRouter, Together, or OpenAI)
# Free tier example (Groq):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=gsk_your_free_groq_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Embeddings & Reranker
# Set USE_LOCAL_TRANSFORMERS=false in lightweight free-tier deployments (512MB RAM) to use fast hashing/API embeddings
USE_LOCAL_TRANSFORMERS=true
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
